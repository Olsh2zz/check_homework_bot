# Файл: .env.example
# Назначение: образец настроек. Скопируйте его в файл .env и подставьте свои значения.

# Токен бота, его выдаёт @BotFather.
BOT_TOKEN=

# Числовой Telegram ID преподавателя, его показывает @userinfobot.
TEACHER_ID=

# Файл базы данных.
DB_PATH=homework.db

# В котором часу (0..23) напоминать о непроверенных работах и в каком часовом поясе.
REMINDER_HOUR=9
TIMEZONE=Europe/Moscow

# Напоминать о работах, которые ждут проверки дольше этого числа дней.
REMINDER_DAYS=2
