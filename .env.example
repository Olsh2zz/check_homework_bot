# Файл: .env.example
# Назначение: образец настроек. Для запуска на своём компьютере скопируйте его
# в файл .env и подставьте свои значения. На Vercel те же переменные задаются
# в настройках проекта.

# Токен бота, его выдаёт @BotFather.
BOT_TOKEN=

# Числовой Telegram ID преподавателя, его показывает @userinfobot.
TEACHER_ID=

# Часовой пояс для дат в карточках работ и для часа напоминания.
TIMEZONE=Europe/Moscow

# Напоминать о работах, которые ждут проверки дольше этого числа дней.
REMINDER_DAYS=2

# ---------- Только для запуска на своём компьютере ----------

# Файл базы данных SQLite.
DB_PATH=homework.db

# В котором часу (0..23) напоминать о непроверенных работах.
# На Vercel время напоминания задаётся в файле vercel.json.
REMINDER_HOUR=9

# ---------- Только для Vercel ----------

# Строка подключения к базе Postgres. Если база Neon создана в панели Vercel,
# он задаёт эту переменную сам.
DATABASE_URL=

# Два случайных секрета из латинских букв и цифр. Первым Telegram подписывает
# свои запросы к боту, вторым Vercel подписывает вызов по расписанию.
WEBHOOK_SECRET=
CRON_SECRET=
